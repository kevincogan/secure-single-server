#!/usr/bin/env python3
"""Call the private management API; save responses in a new root-private file."""
import argparse
import json
import os
from pathlib import Path
import stat

from metering_admin import request

RESOURCES = ('users', 'budgets', 'prices', 'policy', 'keys', 'key-revocations')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('method', choices=('GET', 'POST', 'PUT', 'DELETE'))
    parser.add_argument('resource', choices=RESOURCES)
    parser.add_argument('--input', type=Path, help='root-private JSON request; never pass credentials as arguments')
    parser.add_argument('--output', type=Path, required=True, help='new response file; may contain a one-time key')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run with sudo on the gateway host')
    if (args.method == 'GET') == (args.input is not None):
        parser.error('GET takes no input; mutations require --input')
    payload = None
    if args.input:
        descriptor = os.open(args.input, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(descriptor) as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
                raise ValueError('input must be a root-owned private regular file')
            text = source.read(256 * 1024 + 1)
            if len(text.encode()) > 256 * 1024:
                raise ValueError('input exceeds 256 KiB')
            payload = json.loads(text)
            if not isinstance(payload, dict):
                raise ValueError('input must contain one JSON object')
    # Reserve a safe destination before any API side effect, especially key minting.
    descriptor = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, 'w') as destination:
            response = request(args.method, args.resource, payload)
            json.dump(response, destination, indent=2)
            destination.write('\n')
            destination.flush()
            os.fsync(destination.fileno())
    except Exception:
        # Keep the file for diagnosis: a transport failure does not prove that a
        # mutation failed server-side. Never automatically repeat a key issuance.
        raise ValueError('management request/output failed; inspect server state before retrying; response file retained') from None
    print('Response saved privately: ' + str(args.output))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError):
        raise SystemExit('Management operation failed; check input, output and service state without printing credentials') from None
