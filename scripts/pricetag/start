#!/usr/bin/env bash
# Activate the already prepared PriceTag deployment without changing other services.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/../common/lib.sh"
require_root
readonly DEPLOY_DIR=/etc/praxis-pricetag
readonly PROBE_IMAGE=docker.io/library/python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
adopt_existing_database=0
if [[ "${1:-}" == --adopt-existing-database && "$#" == 1 ]]; then
  adopt_existing_database=1
elif [[ "$#" != 0 ]]; then
  die 'usage: scripts/pricetag/start [--adopt-existing-database]'
fi
[[ -f "${DEPLOY_DIR}/bootstrap.json" ]] || die 'run scripts/pricetag/prepare.py first'
[[ -s "${DEPLOY_DIR}/m2m-secret" ]] || die 'MaaS/PriceTag shared secret is missing; prepare a fresh deployment'
uid="$(service_uid)"
units="/etc/containers/systemd/users/${uid}"
install -d -m 0755 "${units}"
for unit in pricetag.network pricetag-db.volume pricetag-db.container pricetag-maas.container pricetag-metering.container pricetag-gateway.container; do
  install -m 0644 "${DEPLOY_DIR}/quadlets/${unit}" "${units}/${unit}"
done
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-mock.network" ]]; then
  install -m 0644 "${DEPLOY_DIR}/quadlets/pricetag-mock.network" "${units}/pricetag-mock.network"
fi
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-provider.container" ]]; then
  install -m 0644 "${DEPLOY_DIR}/quadlets/pricetag-provider.container" "${units}/pricetag-provider.container"
fi
semanage fcontext -a -t container_file_t '/etc/praxis-pricetag(/.*)?' 2>/dev/null ||
  semanage fcontext -m -t container_file_t '/etc/praxis-pricetag(/.*)?'
restorecon -R "${DEPLOY_DIR}"
as_service systemctl --user daemon-reload
if ! as_service podman secret inspect pricetag-m2m >/dev/null 2>&1; then
  as_service podman secret create pricetag-m2m "${DEPLOY_DIR}/m2m-secret" >/dev/null
fi
as_service systemctl --user start pricetag-db.service
ready=0
for ((attempt=0; attempt<60; attempt++)); do
  if as_service podman exec pricetag-db pg_isready >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
[[ "${ready}" == 1 ]] || die 'PostgreSQL did not become ready'
network_json="$(as_service podman network inspect --format json pricetag-private)" ||
  die 'could not inspect the private MaaS network'
service_addresses="$(printf '%s' "${network_json}" | python3 "${SCRIPT_DIR}/private-network.py" addresses)" ||
  die 'could not select private MaaS, gateway and metering addresses'
printf '%s' "${service_addresses}" | python3 "${SCRIPT_DIR}/private-network.py" configure \
  "${units}/pricetag-maas.container" "${units}/pricetag-gateway.container" \
  "${units}/pricetag-metering.container" ||
  die 'could not restrict MaaS trusted peers to the host and required services'
as_service systemctl --user daemon-reload
pg_admin_user=postgres
pg_admin_database=postgres
if ! as_service podman exec pricetag-db psql -X -qAt -U postgres -d postgres -c 'SELECT 1' >/dev/null 2>&1; then
  pg_admin_user=metering
  pg_admin_database=metering
  is_superuser="$(as_service podman exec pricetag-db psql -X -qAt -U "${pg_admin_user}" \
    -d "${pg_admin_database}" -c 'SELECT rolsuper FROM pg_roles WHERE rolname=current_user' 2>/dev/null || true)"
  [[ "${is_superuser}" == t ]] || die 'PostgreSQL has neither the fresh-install admin nor the supported metering-superuser layout'
fi
if [[ ! -f "${DEPLOY_DIR}/postgres-bootstrap.done" ]]; then
  as_service podman exec -i pricetag-db psql -X -U "${pg_admin_user}" -d "${pg_admin_database}" -v ON_ERROR_STOP=1 \
    < "${DEPLOY_DIR}/initdb/10-create-databases.sql"
  install -m 0600 /dev/null "${DEPLOY_DIR}/postgres-bootstrap.done"
fi
as_service systemctl --user restart pricetag-maas.service
python3 - <<'PY'
import time, urllib.request
for attempt in range(60):
    try:
        with urllib.request.urlopen("http://127.0.0.1:18086/health", timeout=2) as r:
            if r.status == 200:
                break
    except OSError:
        pass
    time.sleep(1)
else:
    raise SystemExit("MaaS API did not become ready")
PY
admin_dir="$(<"${DEPLOY_DIR}/admin-directory")"
install -d -m 0700 "${admin_dir}"
if [[ ! -f "${admin_dir}/admin.key" ]]; then
  python3 "${SCRIPT_DIR}/maas-key" create --subject admin --admin --name admin \
    --url http://127.0.0.1:18086 --output "${admin_dir}/admin.key"
fi
as_service systemctl --user restart pricetag-metering.service
as_service podman run --rm --network pricetag-private "${PROBE_IMAGE}" python3 -c '
import time, urllib.request
for attempt in range(60):
    try:
        with urllib.request.urlopen("http://pricetag-metering:8080/ready", timeout=2) as r:
            if r.status == 200:
                break
    except OSError:
        pass
    time.sleep(1)
else:
    raise SystemExit("metering did not become ready")
'
python3 "${SCRIPT_DIR}/user" --subject admin --name Administrator --no-key --bootstrap-admin
if [[ ! -f "${DEPLOY_DIR}/bootstrap.done" ]]; then
  rows="$(as_service podman exec pricetag-db psql -X -qAt -U metering -d metering -c 'SELECT count(*) FROM usage_events;')"
  if [[ "${rows}" != 0 && "${adopt_existing_database}" != 1 ]]; then
    die 'database already has usage; back it up, review schema and model prices, then use --adopt-existing-database'
  fi
  if ! python3 "${SCRIPT_DIR}/metering_admin.py" --bootstrap "${DEPLOY_DIR}/bootstrap.json"; then
    note 'PriceTag API initialization failed. Gateway startup stopped; inspect service status and rerun start.'
    die 'Keep the prepared files and keys. After fixing the cause, rerun sudo scripts/pricetag/start; do not rerun install or prepare.py.'
  fi
  install -m 0600 /dev/null "${DEPLOY_DIR}/bootstrap.done"
fi
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-provider.container" ]]; then
  as_service systemctl --user start pricetag-provider.service
fi
as_service systemctl --user restart pricetag-gateway.service
python3 - "${DEPLOY_DIR}/ca.pem" <<'PY'
import ssl, sys, time, urllib.request
context = ssl.create_default_context(cafile=sys.argv[1])
for attempt in range(60):
    try:
        with urllib.request.urlopen('https://localhost:8443/login', context=context, timeout=2) as response:
            if response.status == 200:
                break
    except OSError:
        pass
    time.sleep(.5)
else:
    raise SystemExit('gateway HTTPS did not become ready')
PY
if [[ ! -f "${DEPLOY_DIR}/sample-users" ]] || [[ "$(cat "${DEPLOY_DIR}/sample-users")" == yes ]]; then
  for subject in alice bob; do
    if [[ ! -f "${admin_dir}/${subject}.key" ]]; then
      python3 "${SCRIPT_DIR}/user" --subject "${subject}" --name "${subject^}" \
        --output "${admin_dir}/${subject}.key"
    fi
  done
fi
note 'Praxis, MaaS and PriceTag are ready. Inference and dashboard login use finite MaaS keys.'
note "Copy /etc/praxis-pricetag/ca.pem to clients; distribute keys from ${admin_dir} securely."
