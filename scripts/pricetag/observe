#!/usr/bin/env python3
"""Read-only RHEL resource and PostgreSQL samples alongside a bounded load test."""
import argparse
import datetime
import json
import os
from pathlib import Path
import pwd
import subprocess
import time

SERVICES = ['pricetag-' + name for name in ('gateway', 'maas', 'metering', 'db', 'provider')]
SQL = """
SET statement_timeout = '10s';
SELECT json_build_object(
  'database_bytes', pg_database_size(current_database()),
  'wal_directory_bytes', (SELECT COALESCE(sum(size),0) FROM pg_ls_waldir()),
  'usage_events', (SELECT count(*) FROM usage_events),
  'tables', (SELECT json_agg(t) FROM (
    SELECT relname, n_live_tup, n_dead_tup, last_autovacuum, last_autoanalyze,
           pg_total_relation_size(relid) AS total_bytes,
           pg_indexes_size(relid) AS index_bytes
    FROM pg_stat_user_tables ORDER BY pg_total_relation_size(relid) DESC) t),
  'wal', (SELECT row_to_json(w) FROM pg_stat_wal w),
  'database_stats', (SELECT row_to_json(d) FROM (
    SELECT xact_commit,xact_rollback,blks_read,blks_hit,temp_files,temp_bytes,deadlocks
    FROM pg_stat_database WHERE datname=current_database()) d),
  'settings', (SELECT json_object_agg(name,setting) FROM pg_settings WHERE name IN (
    'autovacuum','autovacuum_vacuum_scale_factor','autovacuum_analyze_scale_factor',
    'max_wal_size','min_wal_size','wal_keep_size','max_slot_wal_keep_size',
    'archive_mode','checkpoint_timeout','logging_collector','log_rotation_age','log_rotation_size')),
  'replication_slots', (SELECT json_agg(s) FROM (
    SELECT slot_name,active,wal_status,
           pg_wal_lsn_diff(pg_current_wal_lsn(),restart_lsn) AS retained_bytes
    FROM pg_replication_slots) s)
);
"""


def command(argv, json_output=False):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=20, cwd='/tmp')
    if result.returncode:
        # Never copy arbitrary command stderr or logs into the measurement file.
        return {'error': 'command failed', 'exit_code': result.returncode}
    return json.loads(result.stdout) if json_output else result.stdout.strip()


def sample(prefix):
    memory = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        name, value = line.split(':', 1)
        if name in ('MemTotal', 'MemAvailable', 'MemFree', 'Cached', 'Buffers', 'SwapTotal', 'SwapFree'):
            memory[name + '_kib'] = int(value.split()[0])
    fs = os.statvfs('/var')
    total, available = fs.f_blocks * fs.f_frsize, fs.f_bavail * fs.f_frsize
    record = {'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
              'monotonic_seconds': time.monotonic(), 'memory': memory,
              'disk_total_bytes': total, 'disk_available_bytes': available,
              'disk_available_percent': available * 100 / total,
              'load_average': os.getloadavg(),
              'socket_counters': Path('/proc/net/sockstat').read_text().strip(),
              'ephemeral_port_range': Path('/proc/sys/net/ipv4/ip_local_port_range').read_text().strip(),
              'cpu_ticks': list(map(int, Path('/proc/stat').read_text().splitlines()[0].split()[1:])),
              'pressure': {name: Path('/proc/pressure', name).read_text().strip()
                           for name in ('cpu', 'memory', 'io') if Path('/proc/pressure', name).exists()}}
    record['containers'] = command(prefix + ['podman', 'stats', '--no-stream', '--format', 'json', *SERVICES], True)
    record['services'] = command(prefix + ['systemctl', '--user', 'show', *[s + '.service' for s in SERVICES],
        '--property=Id,ActiveState,NRestarts,MemoryCurrent,MemoryPeak,CPUUsageNSec,TasksCurrent,Result'])
    database_user = 'postgres'
    probe = prefix + ['podman', 'exec', 'pricetag-db', 'psql', '-X', '-qAt',
        '-U', database_user, '-d', 'metering', '-c', 'SELECT 1']
    if command(probe) != '1':
        database_user = 'metering'
    record['postgres'] = command(prefix + ['podman', 'exec', 'pricetag-db', 'psql', '-X', '-qAt',
        '-U', database_user, '-d', 'metering', '-v', 'ON_ERROR_STOP=1', '-c', SQL], True)
    record['journal_usage'] = command(['journalctl', '--disk-usage'])
    record['container_storage'] = command(prefix + ['podman', 'system', 'df', '--format', 'json'], True)
    record['log_config'] = {name: command(prefix + ['podman', 'inspect', '--format',
        '{{json .HostConfig.LogConfig}}', name], True) for name in SERVICES}
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--samples', type=int, default=1)
    parser.add_argument('--interval', type=int, default=30)
    args = parser.parse_args()
    if os.geteuid() != 0 or not Path('/proc/meminfo').is_file():
        parser.error('run with sudo on the RHEL performance VM')
    if not 1 <= args.samples <= 1000 or not 10 <= args.interval <= 300:
        parser.error('samples must be 1–1000; interval must be 10–300 seconds')
    owner = pwd.getpwnam('praxis-svc')
    prefix = ['sudo', '-u', 'praxis-svc', 'env', f'XDG_RUNTIME_DIR=/run/user/{owner.pw_uid}',
              f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{owner.pw_uid}/bus']
    os.umask(0o077)
    with args.output.open('x') as output:
        for index in range(args.samples):
            record = sample(prefix)
            output.write(json.dumps(record) + '\n')
            output.flush()
            if record['disk_available_percent'] < 30:
                raise SystemExit('Less than 30% disk free; stop the load test and review growth')
            if index + 1 < args.samples:
                time.sleep(args.interval)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        raise SystemExit(type(error).__name__ + ': observation failed; inspect host setup') from None
