#!/usr/bin/env python3
"""Provision a MaaS user key and optional PriceTag monthly USD override."""
import argparse
import math
from pathlib import Path
import re
import subprocess
import sys

from metering_admin import provision

ROOT = Path(__file__).resolve().parents[2]


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--subject', required=True)
    p.add_argument('--name', help='display name for the local partner identity')
    p.add_argument('--monthly-usd', type=float, help='optional per-login USD allowance; rotation otherwise leaves it unchanged')
    p.add_argument('--bootstrap-admin', action='store_true', help='SSH-only initial administrator role setup')
    p.add_argument('--rotate', action='store_true', help='replace the same named MaaS key')
    p.add_argument('--output', type=Path, help='new private path for the one-time MaaS key')
    p.add_argument('--no-key', action='store_true', help='create/update the PriceTag identity and budget without issuing or rotating a key')
    p.add_argument('--maas-url', default='http://127.0.0.1:18086')
    p.add_argument('--key-lifetime', default='90d')
    args = p.parse_args()
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}', args.subject):
        p.error('invalid subject')
    if args.monthly_usd is not None and (not math.isfinite(args.monthly_usd) or not 0 < args.monthly_usd <= 10000):
        p.error('monthly-usd must be greater than zero and at most 10000')
    if args.no_key and (args.rotate or args.output):
        p.error('--no-key cannot be combined with --rotate or --output')
    if not args.no_key and args.output is None:
        p.error('key creation requires --output; use --no-key for identity/budget changes only')
    if args.output and (args.output.exists() or args.output.is_symlink()):
        p.error('choose a new output path; existing credentials are never overwritten')
    if args.bootstrap_admin and (args.subject != 'admin' or not args.no_key):
        p.error('--bootstrap-admin requires --subject admin --no-key')
    provision(args.subject, args.name, args.monthly_usd, admin=args.bootstrap_admin)

    command = [sys.executable, str(ROOT / 'scripts/pricetag/maas-key'),
        'rotate' if args.rotate else 'create', '--subject', args.subject,
        '--name', 'inference', '--expires-in', args.key_lifetime,
        '--url', args.maas_url, '--output', str(args.output)]
    if args.subject == 'admin':
        command.append('--admin')
    if not args.no_key:
        subprocess.run(command, check=True)
    print(f'PriceTag partner identity is linked to MaaS subject {args.subject}.')
    if args.monthly_usd is not None:
        print(f'Monthly USD override set to ${args.monthly_usd:.2f}; enforcement cache refreshes within 15 seconds.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error)) from None
