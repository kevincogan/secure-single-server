{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "praxis": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Praxis (llm-d-sc routed)",
      "options": {
        "baseURL": "http://host.openshell.internal:@@PRAXIS_PORT@@/v1",
        "apiKey": "local-placeholder"
      },
      "models": {
        "@@MODEL_ID@@": {
          "name": "Semantic-Qwen (complexity routed)",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "reasoning": true
        }
      }
    }
  }
}
