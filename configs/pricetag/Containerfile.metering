# Packaging only: build an pinned pricetag-metering source archive.
# Match the build host architecture (the upstream Dockerfile forces amd64).
FROM docker.io/library/golang@sha256:0f063af2d465d8dcae54cce04278ada488b96f77b42449c8d071e47d016cc65a AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /metering-service ./cmd
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:beeada7dd17903dfb69fd5f6916c054720bf28a52daaa2f7a1910a1394244bd2
COPY --from=builder /metering-service /metering-service
USER 1001
ENTRYPOINT ["/metering-service"]
