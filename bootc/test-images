#!/usr/bin/env bash
set -euo pipefail
prefix="${1:-localhost/secure-single-server}"
if (( "$#" )); then
  shift
fi
variants=("$@")
if [[ "${#variants[@]}" -eq 0 ]]; then
  variants=(base praxis vllm-cpu vllm-gpu codex opencode openclaw)
fi
for variant in "${variants[@]}"; do
  image="${prefix}:${variant}"
  [[ "$(podman image inspect "${image}" --format '{{.Os}}/{{.Architecture}}')" == linux/amd64 ]] || exit 1
  podman run --rm --network=none --entrypoint /bin/bash "${image}" -euc '
    source /etc/os-release
    [[ "$ID" == rhel && "$VERSION_ID" == 9.* ]]
    test -x /usr/bin/bootc
    test -x /usr/bin/podman
    test ! -e /etc/secure-single-server/vllm-mode
    test ! -e /var/lib/openshell/tls/jwt/signing.pem
    test ! -e /etc/secure-single-server/secret-names
    test ! -e /etc/pki/rhui/content-rhel9.key
    test ! -s /etc/yum.repos.d/bootc-rhui.repo
    root=/usr/share/secure-single-server
    if [[ "$1" == base ]]; then
      test "$(cat "$root/bootc/vllm-profile")" = any
      test -x /usr/bin/openshell
      test "$(/usr/bin/openshell --version)" = "openshell 0.1.5"
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server.service
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-vllm.service
      test -x /usr/share/secure-single-server/bootc/scripts/vllm
      test -f /usr/share/secure-single-server/configs/vllm/images.env
      test ! -e "$root/bootc/harness"
      test ! -d "$root/openshell/harnesses"
    elif [[ "$1" == praxis ]]; then
      test ! -e /usr/bin/openshell
      test ! -e "$root/openshell"
      test -f "$root/configs/all-in-one/shared-gateway.yaml"
      test -f "$root/configs/vllm/praxis-remote.yaml"
      test ! -e "$root/configs/vllm/images.env"
      test ! -L /etc/systemd/system/multi-user.target.wants/secure-single-server.service
      test ! -L /etc/systemd/system/multi-user.target.wants/secure-single-server-vllm.service
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-praxis.service
      test -x /usr/bin/sss-praxis
      test -x "$root/bootc/scripts/praxis"
      test ! -e "$root/bootc/harness"
      test ! -d "$root/openshell/harnesses"
      test ! -x /usr/bin/nvidia-smi
      test ! -x /usr/bin/nvidia-ctk
    elif [[ "$1" == vllm-cpu || "$1" == vllm-gpu ]]; then
      test ! -e /usr/bin/openshell
      test ! -e "$root/openshell"
      test ! -e "$root/configs/all-in-one"
      test ! -L /etc/systemd/system/multi-user.target.wants/secure-single-server.service
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-vllm.service
      test -x /usr/bin/sss-vllm
      test -x /usr/share/secure-single-server/bootc/scripts/vllm
      test -f /usr/share/secure-single-server/configs/vllm/images.env
      test "$(cat "$root/bootc/vllm-profile")" = "${1#vllm-}"
      test ! -e "$root/bootc/harness"
      test ! -d "$root/openshell/harnesses"
      if [[ "$1" == vllm-gpu ]]; then
        test -x /usr/bin/nvidia-smi
        test -x /usr/bin/nvidia-ctk
        if sss-vllm select cpu >/tmp/vllm-profile-check 2>&1; then
          exit 1
        fi
        grep -q "this gpu vLLM image supports only gpu mode" /tmp/vllm-profile-check
      else
        test ! -x /usr/bin/nvidia-smi
        test ! -x /usr/bin/nvidia-ctk
        if sss-vllm select gpu >/tmp/vllm-profile-check 2>&1; then
          exit 1
        fi
        grep -q "this cpu vLLM image supports only cpu mode" /tmp/vllm-profile-check
      fi
    else
      test "$(cat "$root/bootc/vllm-profile")" = any
      test -x /usr/bin/openshell
      test "$(/usr/bin/openshell --version)" = "openshell 0.1.5"
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server.service
      test -L /etc/systemd/system/multi-user.target.wants/secure-single-server-vllm.service
      test -x /usr/share/secure-single-server/bootc/scripts/vllm
      test -f /usr/share/secure-single-server/configs/vllm/images.env
      test "$(cat "$root/bootc/harness")" = "$1"
      test -x "$root/openshell/harnesses/$1/create.sh"
      test -x "$root/openshell/scripts/template.sh"
      test -s "$root/configs/templates/$1.json"
      test "$(find "$root/configs/templates" -name '*.json' | wc -l)" = 1
      test "$(find "$root/openshell/harnesses" -mindepth 1 -maxdepth 1 -type d | wc -l)" = 1
      # Argument parsing must reach validation (catch shared-library readonly collisions).
      if "$root/openshell/harnesses/$1/create.sh" --profile invalid >/tmp/harness-check 2>&1; then
        exit 1
      fi
      grep -q "no template for .*invalid" /tmp/harness-check
    fi
    if [[ "$1" == praxis ]]; then
      sss-praxis help
    elif [[ "$1" != vllm-cpu && "$1" != vllm-gpu ]]; then
      sss-bootc help
      if [[ "$1" == openclaw ]]; then
        test -x "$root/openshell/harnesses/openclaw/run.sh"
        python3 "$root/openshell/scripts/render-openclaw.py" \
          "$root/configs/openshell-praxis/openclaw/harness-provider.json.in" \
          /tmp/openclaw-test.json 8080 fixture-model ""
        python3 -c "import json; c=json.load(open(\"/tmp/openclaw-test.json\")); assert c[\"models\"][\"providers\"][\"praxis\"][\"apiKey\"] == \"local-placeholder\""
        test -f "$root/configs/vllm/openclaw/profiles/dev/policy.yaml"
      fi
    fi
  ' -- "${variant}"
done
