diff --git a/crates/openshell-supervisor-network/src/sender_snapshot.rs b/crates/openshell-supervisor-network/src/sender_snapshot.rs
new file mode 100644
--- /dev/null
+++ b/crates/openshell-supervisor-network/src/sender_snapshot.rs
@@ -0,0 +1,467 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in pilot sender transport. One immutable SVID snapshot per MCP connection.
+//! No bearer fallback, shared token cache, or exported workload private key.
+
+use std::sync::Arc;
+use std::future::Future;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use miette::{IntoDiagnostic, Result, miette};
+use rustls::pki_types::{CertificateDer, PrivateKeyDer};
+use sha2::{Digest, Sha256};
+use spiffe::{SpiffeId, WorkloadApiClient, X509Svid};
+
+/// One immutable identity: OAuth and upstream TLS use the same certificate/key.
+/// Intentionally has no Debug implementation that could include private material.
+pub(crate) struct SenderSnapshot {
+    _svid: X509Svid,
+    pub(crate) subject: SpiffeId,
+    fingerprint: String,
+    not_before: i64,
+    pub(crate) not_after: i64,
+    pub(crate) tls: Arc<rustls::ClientConfig>,
+    pub(crate) oauth: reqwest::Client,
+}
+
+impl SenderSnapshot {
+    /// This compiles the exact Workload API available after enabling X.509.
+    /// Live SPIRE behavior remains a separate deployment acceptance gate.
+    pub(crate) async fn fetch(
+        socket: &str,
+        expected: &str,
+        base: Arc<rustls::ClientConfig>,
+    ) -> Result<Self> {
+        let endpoint = openshell_core::spiffe::workload_api_endpoint(std::path::Path::new(socket));
+        let client = WorkloadApiClient::connect_to(&endpoint)
+            .await
+            .into_diagnostic()?;
+        let all = client.fetch_all_x509_svids().await.into_diagnostic()?;
+        let expected = SpiffeId::try_from(expected).into_diagnostic()?;
+        let mut matches = all.into_iter().filter(|svid| svid.spiffe_id() == &expected);
+        let selected = matches
+            .next()
+            .ok_or_else(|| miette!("expected X.509 identity absent"))?;
+        if matches.next().is_some() {
+            return Err(miette!("ambiguous X.509 identity selection"));
+        }
+        Self::from_svid(selected, &expected.to_string(), base)
+    }
+
+    fn from_svid(svid: X509Svid, expected: &str, base: Arc<rustls::ClientConfig>) -> Result<Self> {
+        let expected = SpiffeId::try_from(expected).into_diagnostic()?;
+        if svid.spiffe_id() != &expected {
+            return Err(miette!("X.509 identity does not match protected workload"));
+        }
+        let leaf = CertificateDer::from(svid.leaf().as_bytes());
+        // This rcgen parser supplies time metadata only. SVID structure was
+        // validated by spiffe; TLS server validation supplies chain validation.
+        let times = rcgen::CertificateParams::from_ca_cert_der(&leaf).into_diagnostic()?;
+        let not_before = times.not_before.unix_timestamp();
+        let not_after = times.not_after.unix_timestamp();
+        valid_at(not_before, not_after, now())?;
+        let fingerprint = hex::encode(Sha256::digest(svid.leaf().as_bytes()));
+        let chain = svid
+            .cert_chain()
+            .iter()
+            .map(|cert| CertificateDer::from(cert.as_bytes().to_vec()))
+            .collect();
+        let key = PrivateKeyDer::try_from(svid.private_key().as_bytes().to_vec())
+            .map_err(|_| miette!("invalid X.509 private-key encoding"))?;
+        let signing_key =
+            rustls::crypto::aws_lc_rs::sign::any_supported_type(&key).into_diagnostic()?;
+        let certified = rustls::sign::CertifiedKey::new(chain, signing_key);
+        certified.keys_match().into_diagnostic()?;
+        let mut tls = (*base).clone();
+        tls.client_auth_cert_resolver = Arc::new(SnapshotResolver(Arc::new(certified)));
+        tls.alpn_protocols = vec![b"http/1.1".to_vec()];
+        // One certificate snapshot per client/connection. Disable idle reuse
+        // for the pilot; a future pool must partition by fingerprint and run.
+        let oauth = reqwest::Client::builder()
+            .use_preconfigured_tls(tls.clone())
+            .https_only(true)
+            .http1_only()
+            .pool_max_idle_per_host(0)
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .timeout(Duration::from_secs(15))
+            .connect_timeout(Duration::from_secs(15))
+            .build()
+            .into_diagnostic()?;
+        Ok(Self {
+            subject: svid.spiffe_id().clone(),
+            _svid: svid,
+            fingerprint,
+            not_before,
+            not_after,
+            tls: Arc::new(tls),
+            oauth,
+        })
+    }
+
+    pub(crate) fn ensure_valid(&self) -> Result<()> {
+        valid_at(self.not_before, self.not_after, now())
+    }
+
+
+}
+
+#[derive(Debug)]
+struct SnapshotResolver(Arc<rustls::sign::CertifiedKey>);
+
+impl rustls::client::ResolvesClientCert for SnapshotResolver {
+    fn resolve(
+        &self,
+        _root_hint_subjects: &[&[u8]],
+        schemes: &[rustls::SignatureScheme],
+    ) -> Option<Arc<rustls::sign::CertifiedKey>> {
+        self.0.key.choose_scheme(schemes)?;
+        Some(Arc::clone(&self.0))
+    }
+    fn has_certs(&self) -> bool {
+        true
+    }
+}
+
+/// Enabled only for one explicitly compiled pilot hostname. Other endpoints keep
+/// the official transport. The trusted supervisor supplies the socket and sandbox ID.
+pub(crate) async fn for_connection(
+    host: &str,
+    port: u16,
+    base: &Arc<rustls::ClientConfig>,
+) -> Result<Option<Arc<SenderSnapshot>>> {
+    let Some(expected_host) = option_env!("OPENSHELL_DEMO_SENDER_HOST") else {
+        return Ok(None);
+    };
+    if expected_host.is_empty() {
+        return Err(miette!("empty compiled sender host"));
+    }
+    if host != expected_host || port != 443 {
+        return Ok(None);
+    }
+    let socket = std::env::var(openshell_core::sandbox_env::PROVIDER_SPIFFE_WORKLOAD_API_SOCKET)
+        .into_diagnostic()?;
+    let sandbox_id = std::env::var(openshell_core::sandbox_env::SANDBOX_ID).into_diagnostic()?;
+    let expected = format!("spiffe://agents.example.test/openshell/sandbox/{sandbox_id}");
+    let snapshot = tokio::time::timeout(
+        Duration::from_secs(10),
+        SenderSnapshot::fetch(&socket, &expected, Arc::clone(base)),
+    )
+    .await
+    .into_diagnostic()??;
+    Ok(Some(Arc::new(snapshot)))
+}
+
+impl crate::l7::token_grant_injection::TokenGrantResolver for SenderSnapshot {
+    fn obtain<'a>(
+        &'a self,
+        request: crate::l7::token_grant_injection::TokenGrantRequest<'a>,
+    ) -> std::pin::Pin<Box<dyn Future<Output = Result<String>> + Send + 'a>> {
+        Box::pin(async move {
+            self.ensure_valid()?;
+            // The compiled pilot endpoint cannot be redirected by provider metadata.
+            // This protects the workload certificate and intermediate human token.
+            if Some(request.token_endpoint) != option_env!("OPENSHELL_DEMO_TOKEN_ENDPOINT")
+                || Some(request.jwt_svid_audience) != option_env!("OPENSHELL_DEMO_JWT_AUDIENCE")
+                || Some(request.audience) != option_env!("OPENSHELL_DEMO_MCP_AUDIENCE")
+            {
+                tracing::warn!("Pilot sender contract rejected: endpoint_contract");
+                return Err(miette!("sender-bound pilot endpoint/audiences differ from reviewed inputs"));
+            }
+            if request.grant_type
+                != openshell_core::proto::ProviderCredentialTokenGrantType::TokenExchange as i32
+                || request.cache_ttl.is_none_or(|ttl| !ttl.is_zero())
+            {
+                tracing::warn!("Pilot sender contract rejected: cache_contract");
+                return Err(miette!(
+                    "sender-bound pilot requires exchange and disabled token caching"
+                ));
+            }
+            let token = crate::token_grant::obtain_provider_token_with_sender(
+                crate::token_grant::ObtainProviderTokenRequest {
+                    provider_name: request.provider_key,
+                    token_endpoint: request.token_endpoint,
+                    jwt_svid_audience: request.jwt_svid_audience,
+                    client_assertion_type: request.client_assertion_type,
+                    audience: request.audience,
+                    scopes: request.scopes,
+                    cache_ttl_override: Some(Duration::ZERO),
+                    grant_type: request.grant_type,
+                    requested_token_type: request.requested_token_type,
+                },
+                Some(self),
+            )
+            .await?;
+            tracing::info!("Pilot sender checkpoint: final_token_received");
+            self.ensure_valid()?;
+            // Defensive consistency check on the TLS-authenticated issuer response.
+            // The gateway independently verifies the token signature and all claims.
+            use base64::Engine as _;
+            let payload = token
+                .split('.')
+                .nth(1)
+                .ok_or_else(|| miette!("missing JWT payload"))?;
+            let value: serde_json::Value = serde_json::from_slice(
+                &base64::engine::general_purpose::URL_SAFE_NO_PAD
+                    .decode(payload)
+                    .into_diagnostic()?,
+            )
+            .into_diagnostic()?;
+            let fingerprint = base64::engine::general_purpose::URL_SAFE_NO_PAD
+                .encode(hex::decode(&self.fingerprint).into_diagnostic()?);
+            if value["cnf"]["x5t#S256"].as_str() != Some(fingerprint.as_str())
+                || value["azp"].as_str() != Some(self.subject.to_string().as_str())
+                || value["exp"]
+                    .as_i64()
+                    .is_none_or(|exp| exp <= now() || exp > self.not_after)
+            {
+                tracing::warn!(
+                    "Pilot sender binding rejected: cnf_match={} workload_match={} token_expiry={:?} certificate_expiry={}",
+                    value["cnf"]["x5t#S256"].as_str() == Some(fingerprint.as_str()),
+                    value["azp"].as_str() == Some(self.subject.to_string().as_str()),
+                    value["exp"].as_i64(),
+                    self.not_after,
+                );
+                return Err(miette!("issuer did not return the required sender binding"));
+            }
+            Ok(token)
+        })
+    }
+}
+
+fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(i64::MAX, |time| {
+            i64::try_from(time.as_secs()).unwrap_or(i64::MAX)
+        })
+}
+
+fn valid_at(not_before: i64, not_after: i64, now: i64) -> Result<()> {
+    if now < not_before || now >= not_after || not_before >= not_after {
+        return Err(miette!("X.509 snapshot is outside its validity window"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rcgen::{
+        Certificate, CertificateParams, ExtendedKeyUsagePurpose, IsCa, KeyPair, KeyUsagePurpose,
+        SanType,
+    };
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::{TcpListener, TcpStream};
+    use tokio_rustls::TlsAcceptor;
+
+    const SUBJECT: &str = "spiffe://identity-demo.example.test/openshell/sandbox/a";
+    const OTHER: &str = "spiffe://identity-demo.example.test/openshell/sandbox/b";
+
+    fn crypto() {
+        let _ = rustls::crypto::aws_lc_rs::default_provider().install_default();
+    }
+
+    fn ca() -> (Certificate, KeyPair) {
+        crypto();
+        let key = KeyPair::generate().unwrap();
+        let mut params = CertificateParams::default();
+        params.is_ca = IsCa::Ca(rcgen::BasicConstraints::Unconstrained);
+        params.key_usages = vec![KeyUsagePurpose::KeyCertSign, KeyUsagePurpose::CrlSign];
+        (params.self_signed(&key).unwrap(), key)
+    }
+
+    fn client_config(ca: &Certificate) -> Arc<rustls::ClientConfig> {
+        Arc::new(
+            rustls::ClientConfig::builder()
+                .with_root_certificates(roots(ca))
+                .with_no_client_auth(),
+        )
+    }
+
+    fn roots(ca: &Certificate) -> rustls::RootCertStore {
+        let mut store = rustls::RootCertStore::empty();
+        store.add(ca.der().clone()).unwrap();
+        store
+    }
+
+    fn svid(subject: &str, ca: &Certificate, ca_key: &KeyPair) -> X509Svid {
+        let key = KeyPair::generate().unwrap();
+        let mut params = CertificateParams::default();
+        params.is_ca = IsCa::ExplicitNoCa;
+        params.subject_alt_names = vec![SanType::URI(subject.try_into().unwrap())];
+        params.use_authority_key_identifier_extension = true;
+        params.key_usages = vec![KeyUsagePurpose::DigitalSignature];
+        params.extended_key_usages = vec![
+            ExtendedKeyUsagePurpose::ClientAuth,
+            ExtendedKeyUsagePurpose::ServerAuth,
+        ];
+        let cert = params.signed_by(&key, ca, ca_key).unwrap();
+        X509Svid::parse_from_der(cert.der().as_ref(), &key.serialize_der()).unwrap()
+    }
+
+    #[test]
+    fn wrong_workload_is_rejected() {
+        let (ca, key) = ca();
+        assert!(
+            SenderSnapshot::from_svid(svid(OTHER, &ca, &key), SUBJECT, client_config(&ca)).is_err()
+        );
+    }
+
+    #[test]
+    fn fingerprint_is_exact_leaf_der_digest() {
+        let (ca, key) = ca();
+        let svid = svid(SUBJECT, &ca, &key);
+        let expected = hex::encode(Sha256::digest(svid.leaf().as_bytes()));
+        let snapshot = SenderSnapshot::from_svid(svid, SUBJECT, client_config(&ca)).unwrap();
+        assert_eq!(snapshot.fingerprint, expected);
+    }
+
+    #[test]
+    fn validity_fails_closed_at_both_boundaries() {
+        assert!(valid_at(100, 200, 99).is_err());
+        assert!(valid_at(100, 200, 100).is_ok());
+        assert!(valid_at(100, 200, 199).is_ok());
+        assert!(valid_at(100, 200, 200).is_err());
+        assert!(valid_at(100, 100, 100).is_err());
+        assert!(valid_at(200, 100, 150).is_err());
+    }
+
+    #[test]
+    fn rotated_leaf_changes_binding_while_preserving_workload() {
+        let (ca, key) = ca();
+        let first = SenderSnapshot::from_svid(svid(SUBJECT, &ca, &key), SUBJECT, client_config(&ca)).unwrap();
+        let rotated = SenderSnapshot::from_svid(svid(SUBJECT, &ca, &key), SUBJECT, client_config(&ca)).unwrap();
+        assert_ne!(first.fingerprint, rotated.fingerprint);
+        assert_eq!(first.subject, rotated.subject);
+    }
+
+    #[test]
+    fn mismatched_certificate_and_private_key_are_rejected() {
+        let (ca, key) = ca();
+        let first = svid(SUBJECT, &ca, &key);
+        let other = svid(SUBJECT, &ca, &key);
+        let mismatched =
+            X509Svid::parse_from_der(first.leaf().as_bytes(), other.private_key().as_bytes())
+                .unwrap();
+        assert!(SenderSnapshot::from_svid(mismatched, SUBJECT, client_config(&ca)).is_err());
+    }
+
+    #[tokio::test]
+    async fn native_oauth_helper_and_upstream_tls_present_same_leaf() {
+        tokio::time::timeout(Duration::from_secs(20), same_leaf_handshakes())
+            .await
+            .unwrap();
+    }
+
+    async fn same_leaf_handshakes() {
+        let (ca, ca_key) = ca();
+        let snapshot =
+            SenderSnapshot::from_svid(svid(SUBJECT, &ca, &ca_key), SUBJECT, client_config(&ca))
+                .unwrap();
+        let expected = snapshot.fingerprint.clone();
+        let server_key = KeyPair::generate().unwrap();
+        let mut params = CertificateParams::new(vec!["localhost".to_string()]).unwrap();
+        params.use_authority_key_identifier_extension = true;
+        params.extended_key_usages = vec![ExtendedKeyUsagePurpose::ServerAuth];
+        let server_cert = params.signed_by(&server_key, &ca, &ca_key).unwrap();
+        let client_verifier = rustls::server::WebPkiClientVerifier::builder(Arc::new(roots(&ca)))
+            .build()
+            .unwrap();
+        let mut server_config = rustls::ServerConfig::builder()
+            .with_client_cert_verifier(client_verifier)
+            .with_single_cert(
+                vec![server_cert.der().clone()],
+                PrivateKeyDer::try_from(server_key.serialize_der()).unwrap(),
+            )
+            .unwrap();
+        server_config.alpn_protocols = vec![b"http/1.1".to_vec()];
+        let acceptor = TlsAcceptor::from(Arc::new(server_config));
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let server = tokio::spawn(async move {
+            let mut paths = Vec::new();
+            let mut fingerprints = Vec::new();
+            for _ in 0..2 {
+                let (stream, _) = listener.accept().await.unwrap();
+                let mut tls = acceptor.accept(stream).await.unwrap();
+                let cert = &tls.get_ref().1.peer_certificates().unwrap()[0];
+                fingerprints.push(hex::encode(Sha256::digest(cert.as_ref())));
+                let mut input = Vec::new();
+                let mut buf = [0u8; 1024];
+                loop {
+                    let count = tls.read(&mut buf).await.unwrap();
+                    assert!(count > 0);
+                    input.extend_from_slice(&buf[..count]);
+                    if let Some(end) = input.windows(4).position(|bytes| bytes == b"\r\n\r\n") {
+                        let headers = std::str::from_utf8(&input[..end]).unwrap();
+                        let length = headers
+                            .lines()
+                            .find_map(|line| {
+                                let (name, value) = line.split_once(':')?;
+                                name.eq_ignore_ascii_case("content-length")
+                                    .then(|| value.trim().parse::<usize>().unwrap())
+                            })
+                            .unwrap_or(0);
+                        if input.len() >= end + 4 + length {
+                            paths.push(
+                                headers
+                                    .lines()
+                                    .next()
+                                    .unwrap()
+                                    .split_whitespace()
+                                    .nth(1)
+                                    .unwrap()
+                                    .to_string(),
+                            );
+                            break;
+                        }
+                    }
+                }
+                let body = br#"{"access_token":"synthetic-review-token","expires_in":30,"token_type":"Bearer"}"#;
+                let headers = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                    body.len()
+                );
+                tls.write_all(headers.as_bytes()).await.unwrap();
+                tls.write_all(body).await.unwrap();
+                tls.shutdown().await.unwrap();
+            }
+            (paths, fingerprints)
+        });
+        snapshot.ensure_valid().unwrap();
+        let response = openshell_core::oauth::post_oauth_token_exchange(
+            &snapshot.oauth,
+            &format!("https://localhost:{port}/realms/review/protocol/openid-connect/token"),
+            &openshell_core::oauth::TokenExchangeParams {
+                client_assertion: "synthetic-review-assertion",
+                client_assertion_type: "urn:ietf:params:oauth:client-assertion-type:jwt-spiffe",
+                subject_token: "synthetic-review-human-token",
+                subject_token_type: openshell_core::oauth::ACCESS_TOKEN_TYPE,
+                audience: "synthetic-review-mcp",
+                scopes: &[],
+                requested_token_type: openshell_core::oauth::ACCESS_TOKEN_TYPE,
+            },
+        )
+        .await
+        .unwrap();
+        assert_eq!(response.expires_in, 30);
+        snapshot.ensure_valid().unwrap();
+        let stream = TcpStream::connect(("127.0.0.1", port)).await.unwrap();
+        let mut stream = crate::l7::tls::tls_connect_upstream(stream, "localhost", &snapshot.tls)
+            .await
+            .unwrap();
+        stream
+            .write_all(b"GET /mcp HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
+            .await
+            .unwrap();
+        let mut reply = Vec::new();
+        stream.read_to_end(&mut reply).await.unwrap();
+        assert!(reply.starts_with(b"HTTP/1.1 200 OK"));
+        let (paths, fingerprints) = server.await.unwrap();
+        assert_eq!(
+            paths,
+            vec!["/realms/review/protocol/openid-connect/token", "/mcp"]
+        );
+        assert_eq!(fingerprints, vec![expected.clone(), expected]);
+    }
+}
