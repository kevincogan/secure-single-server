+++ b/crates/openshell-server/src/grpc/provider/supervisor_identity.rs
@@ -0,0 +1,144 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Exact subject comparison for the pilot's protected canonical registrations.
+//!
+//! This module does not authenticate a JWT or a caller. The handler must verify
+//! the caller's sandbox scope and JWT-SVID signature, audience and trust bundle
+//! before using this predicate. The identity path is the protected convention in
+//! `deploy/helm/openshell/ci/values-spire-stack.yaml`. Different registration paths
+//! intentionally fail closed; this is not a configurable upstream identity map.
+
+pub(super) fn subject_matches_canonical_sandbox(
+    verified_subject: &str,
+    gateway_trust_domain: &str,
+    authenticated_sandbox_id: &str,
+) -> bool {
+    // Both values come from trusted state. Reject path/URI syntax if a future
+    // caller violates that contract; do not normalize attacker-supplied subjects.
+    if gateway_trust_domain.is_empty()
+        || !gateway_trust_domain.bytes().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'.' | b'-' | b'_')
+        })
+        || authenticated_sandbox_id.is_empty()
+        || !authenticated_sandbox_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        return false;
+    }
+
+    verified_subject
+        == format!("spiffe://{gateway_trust_domain}/openshell/sandbox/{authenticated_sandbox_id}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::subject_matches_canonical_sandbox;
+
+    const DOMAIN: &str = "identity-demo.example.test";
+    const SANDBOX: &str = "00000000-0000-4000-8000-000000000001";
+    const EXPECTED: &str = "spiffe://identity-demo.example.test/openshell/sandbox/00000000-0000-4000-8000-000000000001";
+
+    #[test]
+    fn accepts_the_authenticated_sandbox_exact_subject() {
+        assert!(subject_matches_canonical_sandbox(EXPECTED, DOMAIN, SANDBOX));
+    }
+
+    #[test]
+    fn rejects_a_different_sandbox_in_the_same_domain() {
+        assert!(!subject_matches_canonical_sandbox(
+            "spiffe://identity-demo.example.test/openshell/sandbox/fixture-step4-substitution",
+            DOMAIN,
+            SANDBOX,
+        ));
+    }
+
+    #[test]
+    fn rejects_the_gateway_subject_in_the_same_domain() {
+        assert!(!subject_matches_canonical_sandbox(
+            "spiffe://identity-demo.example.test/openshell/gateway/fixture-openshell",
+            DOMAIN,
+            SANDBOX,
+        ));
+    }
+
+    #[test]
+    fn rejects_the_bootstrap_jwt_subject_convention() {
+        assert!(!subject_matches_canonical_sandbox(
+            "spiffe://openshell/sandbox/00000000-0000-4000-8000-000000000001",
+            DOMAIN,
+            SANDBOX,
+        ));
+    }
+
+    #[test]
+    fn rejects_other_trust_domains() {
+        assert!(!subject_matches_canonical_sandbox(
+            EXPECTED,
+            "other.test",
+            SANDBOX
+        ));
+    }
+
+    #[test]
+    fn rejects_prefix_and_suffix_matches() {
+        for subject in [format!("{EXPECTED}-other"), format!("{EXPECTED}/other")] {
+            assert!(!subject_matches_canonical_sandbox(
+                &subject, DOMAIN, SANDBOX
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_uri_normalization_shortcuts() {
+        for subject in [
+            format!("{EXPECTED}/"),
+            format!("{EXPECTED}?run=approved"),
+            format!("{EXPECTED}#approved"),
+            EXPECTED.replace("/sandbox/", "/sandbox/../sandbox/"),
+            EXPECTED.replace("/sandbox/", "/%73andbox/"),
+            EXPECTED.replace("spiffe:", "SPIFFE:"),
+        ] {
+            assert!(!subject_matches_canonical_sandbox(
+                &subject, DOMAIN, SANDBOX
+            ));
+        }
+    }
+
+    #[test]
+    fn rejects_noncanonical_registration_paths() {
+        assert!(!subject_matches_canonical_sandbox(
+            "spiffe://identity-demo.example.test/custom/sandbox/00000000-0000-4000-8000-000000000001",
+            DOMAIN,
+            SANDBOX,
+        ));
+    }
+
+    #[test]
+    fn rejects_missing_trusted_inputs() {
+        assert!(!subject_matches_canonical_sandbox(EXPECTED, "", SANDBOX));
+        assert!(!subject_matches_canonical_sandbox(EXPECTED, DOMAIN, ""));
+    }
+
+    #[test]
+    fn rejects_uri_syntax_in_trusted_inputs() {
+        for domain in [
+            "test/evil",
+            "test:443",
+            "test?evil",
+            "test#evil",
+            "test%2f",
+            "TEST",
+        ] {
+            assert!(!subject_matches_canonical_sandbox(
+                EXPECTED, domain, SANDBOX
+            ));
+        }
+        for sandbox in ["a/b", "..", "a?b", "a#b", "a%2fb", "a b"] {
+            assert!(!subject_matches_canonical_sandbox(
+                EXPECTED, DOMAIN, sandbox
+            ));
+        }
+    }
+}
