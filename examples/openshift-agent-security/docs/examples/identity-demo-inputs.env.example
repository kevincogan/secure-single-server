# Copy outside Git, edit paths, then source the private copy. No secret values here.
export DEMO_PRIVATE_ROOT="/absolute/private/identity-demo"
export DEMO_PRIVATE_STORAGE="$DEMO_PRIVATE_ROOT"
export DEMO_PYTHON="$DEMO_PRIVATE_ROOT/venv/bin/python"
export DEMO_KUBECONFIG="$DEMO_PRIVATE_ROOT/kubeconfig"
export DEMO_SERVER="https://api.cluster.example.org:6443"
# Must match the authenticated non-admin user for access preparation/install.
export DEMO_INSTALLER_USER="your-platform-installer-user"
# Platform account is separate; never silently elevate the application installer.
export DEMO_PLATFORM_KUBECONFIG="$DEMO_PRIVATE_ROOT/platform-kubeconfig"
export DEMO_SECURITY_PROFILE="$DEMO_PRIVATE_ROOT/security-profile.json"
export DEMO_SECURITY_NETWORK="$DEMO_PRIVATE_ROOT/security-network.json"
# Source installation and native publication; retain independent hashes.
export DEMO_PACKAGE_OUTPUT="$DEMO_PRIVATE_ROOT/package"
export DEMO_INSTALLATION_CONFIG="$DEMO_PRIVATE_ROOT/installation-config.private.json"
export DEMO_INSTALLATION_STATE="$DEMO_PACKAGE_OUTPUT/render-01/installation-state.private.json"
export DEMO_INSTALLATION_PROFILE="$DEMO_PACKAGE_OUTPUT/render-01/installation-profile.json"
export DEMO_NATIVE_BUILD_RECEIPT="$DEMO_PACKAGE_OUTPUT/native-build-01/native-build.receipt.json"
export DEMO_NATIVE_BUILD_SHA256="replace-with-recorded-receipt-sha256"
export DEMO_PUBLICATION_NETWORK="$DEMO_PRIVATE_ROOT/publication-network.private.json"
export DEMO_PUBLICATION_PLAN="$DEMO_PACKAGE_OUTPUT/publication-01/publication.plan.private.json"
export DEMO_PUBLICATION_PLAN_SHA256="replace-with-recorded-plan-sha256"
export DEMO_ARTIFACTS_FILE="$DEMO_PRIVATE_ROOT/artifacts.private.json"
export DEMO_CONNECTED="$DEMO_PRIVATE_STORAGE/connected-install-01"
export DEMO_FIXTURE_CREDENTIALS="$DEMO_CONNECTED/02-render/fixture-credentials.private.json"
export DEMO_OPENSHELL_CLI="$DEMO_PRIVATE_ROOT/cli/openshell"
export DEMO_CLI_CONFIG="$DEMO_CONNECTED/cli-config"
export DEMO_DRIVER_CREDENTIALS="$DEMO_CONNECTED/driver-credentials.private.json"
export DEMO_CATALOG_CREDENTIAL="$DEMO_CONNECTED/catalog-credential.private.json"
export DEMO_INFERENCE_CONFIG="$DEMO_PRIVATE_ROOT/configuration-01/inference-config.private.json"
# Set these for each newly provisioned scenario; never reuse a retired identity.
export DEMO_FRESH_CONTEXT="$DEMO_PRIVATE_ROOT/context-new/context.private.json"
export DEMO_FRESH_OUTPUT="$DEMO_PRIVATE_ROOT/walkthrough-new"
# Optional diagnostic staging, requiring pods/ephemeralcontainers permission.
export DEMO_SPIRE_ARCHIVE="$DEMO_PRIVATE_ROOT/spire-1.14.7-linux-amd64-musl.tar.gz"
export DEMO_SPIRE_AGENT="$DEMO_PRIVATE_ROOT/diagnostic-build/binaries/spire-agent"
export DEMO_PROJECTION_READER="$DEMO_PRIVATE_ROOT/diagnostic-build/binaries/read-native-projection"
export DEMO_MCP_CLIENT="$DEMO_PROJECTION_READER" # Historical variable alias.
export DEMO_SECURITY_OUTPUT="$DEMO_PRIVATE_ROOT/read-security-new"
# Optional presentation: use actual passing receipts and a still-existing TUI context.
export DEMO_EXISTING_CONTEXT="$DEMO_PRIVATE_ROOT/context-existing/context.private.json"
export DEMO_MODEL_ANALYST_OUTPUT="$DEMO_PRIVATE_ROOT/walkthrough-model-analyst"
export DEMO_MODEL_VIEWER_OUTPUT="$DEMO_PRIVATE_ROOT/walkthrough-model-viewer"
export DEMO_VERIFIED_JIRA_PNG="$DEMO_PRIVATE_ROOT/jira-preview/verified-issue.png"

# Every execution command must select the current rendered installation explicitly.
## After render/install succeeds, enable for execution:
# export IDENTITY_DEMO_CONFIG="$DEMO_INSTALLATION_PROFILE"
# export IDENTITY_DEMO_ARTIFACTS="$DEMO_ARTIFACTS_FILE"
export DEMO_RUNTIME_CA="$DEMO_PACKAGE_OUTPUT/render-01/runtime-gateway-ca.pem"
export DEMO_NATIVE_PUBLIC_TRUST="$DEMO_PACKAGE_OUTPUT/render-01/native-public-trust.pem"
export DEMO_OPENSHELL_SOURCE_ARCHIVE="$DEMO_PRIVATE_ROOT/openshell-source.tar.gz"
# Exact trusted-issuer subject allowed to request Settings preparation (not username).
export DEMO_PRESENTER_SUBJECT="replace-with-trusted-presenter-subject"
export DEMO_CORE_NAMESPACE="replace-with-core-namespace-from-profile"

# Explicit opt-in after persistent gateway installation; keep these in the private environment.
# export DEMO_GATEWAY_MODE=persistent
# export DEMO_GATEWAY_RECEIPT=/absolute/private/demo/gateway-install-01/persistent-gateway.receipt.private.json
# export DEMO_POOL_MODE=automatic
# export DEMO_PREPARER_CLI_CONFIG=/absolute/private/demo/cli-config-preparer
# export DEMO_PREPARER_MANAGEMENT_PORT=18444
